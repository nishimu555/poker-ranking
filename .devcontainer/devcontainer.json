// AI 駆動開発の基盤用 Dev Container（共通部分のひな形）
// - Claude Code は公式の Dev Container Feature で導入する。
// - プログラミング言語・ツールは、c1 実装計画「2. 開発の前提」で決まった内容を features に追加する。
// - 通信先の制限（ファイアウォール）が必要な場合は、guide/04_sandbox.md を参照する。
// 参考：https://code.claude.com/docs/en/devcontainer
{
  "name": "ai-dev-base",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    // Task-002: Node.js の版を固定する（implementation-plan.md 2.、c1/Question-023）
    "ghcr.io/devcontainers/features/node:1": { "version": "24.21.0" },
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
    // 例：言語を追加する場合
    // "ghcr.io/devcontainers/features/python:1": {}
  },
  // root 以外のユーザーで実行する
  "remoteUser": "vscode",
  // Claude Code の認証・設定をコンテナの再作成後も保持する（プロジェクトごとに分離）
  "mounts": [
    "source=claude-code-config-${devcontainerId},target=/home/vscode/.claude,type=volume"
  ],
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude",
    // 時刻を日本時間（JST）にする（コンテナの既定は UTC）。記録の日時を JST で残すため
    "TZ": "Asia/Tokyo"
  },
  // フック（.claude/hooks/）が使う jq を導入し、フックに実行権限を付ける
  // Task-002: 開発用の依存ライブラリを package-lock.json のとおりに導入する（npm ci）
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y jq && chmod +x .claude/hooks/*.sh && npm ci"
  // 注意：~/.ssh、clasp の認証情報（~/.clasprc.json）、クラウドの認証情報ファイル等、ホストの秘密情報をマウントしない。
  // clasp login はコンテナ内で行う（c1/Question-010）
}
